<section class="hero">
  {% if section.settings.hero_image != blank %}
    <div class="hero-photo" style="background-image:linear-gradient(90deg,rgba(5,10,12,.96) 0%,rgba(5,10,12,.76) 45%,rgba(5,10,12,.1) 100%),url('{{ section.settings.hero_image | image_url: width: 2200 }}')"></div>
  {% else %}
    <div class="hero-photo hero-placeholder"></div>
  {% endif %}
  <div class="hero-content">
    <p class="script">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.headline | escape | replace: 'Bhai', '<em>Bhai</em>' }}</h1>
    <h2>{{ section.settings.tagline | escape }}</h2>
    <p class="hero-description">{{ section.settings.description | escape }}</p>
    <a class="button button-gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <span>→</span></a>
  </div>
  <div class="hero-note">Shop Smart<br>Live Better<span></span></div>
</section>
{% schema %}
{"name":"Premium hero banner","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Welcome to"},{"type":"text","id":"headline","label":"Headline","default":"Cart2Mart"},{"type":"text","id":"tagline","label":"Tagline","default":"Best Products | Better Price | Trusted Always"},{"type":"textarea","id":"description","label":"Description","default":"Quality products, great prices and a hassle-free shopping experience — only at Cart2Mart."},{"type":"text","id":"button_label","label":"Button label","default":"Shop Now"},{"type":"url","id":"button_link","label":"Button link"},{"type":"image_picker","id":"hero_image","label":"Hero background image"}],"presets":[{"name":"Premium hero banner"}]}
{% endschema %}