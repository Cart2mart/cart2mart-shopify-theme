<section class="collection-page section-width"><h1>Search</h1><form action="{{ routes.search_url }}" method="get" class="search-form search-page"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products"><button class="button button-gold">Search</button></form>{% if search.performed %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}<article class="product-card"><a class="product-image" href="{{ item.url }}">{% if item.featured_image %}<img src="{{ item.featured_image | image_url: width: 700 }}" alt="{{ item.title | escape }}">{% endif %}</a><div class="product-info"><a class="product-title" href="{{ item.url }}">{{ item.title | escape }}</a>{% if item.price %}<div class="product-price">{{ item.price | money }}</div>{% endif %}</div></article>{% endif %}{% endfor %}</div>{% endif %}</section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}